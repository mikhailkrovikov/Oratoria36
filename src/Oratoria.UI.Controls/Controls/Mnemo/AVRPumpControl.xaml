<UserControl x:Class="Oratoria.UI.Controls.Mnemo.AVRPumpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="108"
             d:DesignHeight="142">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PumpShape" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Text}"
                   FontWeight="Bold"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,2"
                   Grid.Row="0"/>

        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButton}"
                Cursor="Hand"
                Grid.Row="1">
            <Viewbox Stretch="Uniform">
                <Canvas Width="150" Height="150" Background="Transparent">
                    <Path x:Name="Body"
                          Canvas.Left="20" Canvas.Top="20"
                          Style="{StaticResource PumpShape}">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure IsClosed="True" StartPoint="0,0">
                                    <LineSegment Point="110,0"/>
                                    <LineSegment Point="110,110"/>
                                    <LineSegment Point="0,110"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>

                    <Path Style="{StaticResource PumpShape}">
                        <Path.Data>
                            <LineGeometry StartPoint="40,40" EndPoint="55,55"/>
                        </Path.Data>
                    </Path>

                    <Path Style="{StaticResource PumpShape}">
                        <Path.Data>
                            <LineGeometry StartPoint="95,95" EndPoint="110,110"/>
                        </Path.Data>
                    </Path>

                    <Ellipse Width="60" Height="60"
                             Canvas.Left="46" Canvas.Top="45"
                             Style="{StaticResource PumpShape}"/>

                    <Viewbox x:Name="ErrorOverlay"
                             Width="30" Height="30"
                             Canvas.Left="20" Canvas.Top="20"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Canvas Width="50" Height="50">
                            <Ellipse x:Name="ErrorBadge"
                                     Width="50" Height="50"
                                     Stroke="Black"
                                     StrokeThickness="3"/>
                            <Rectangle Width="6" Height="20"
                                       Canvas.Left="22" Canvas.Top="10"
                                       RadiusX="1" RadiusY="1"
                                       Fill="Black"/>
                            <Ellipse Width="6" Height="6"
                                     Canvas.Left="22" Canvas.Top="34"
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
