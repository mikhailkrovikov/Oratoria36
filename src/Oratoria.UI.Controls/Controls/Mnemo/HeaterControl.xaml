<UserControl x:Class="Oratoria.UI.Controls.Mnemo.HeaterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="150"
             d:DesignHeight="55">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HeaterShape" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButton}"
                Cursor="Hand">
            <Grid>
                <Rectangle x:Name="Body"
                           RadiusX="5"
                           RadiusY="5"
                           Style="{StaticResource HeaterShape}"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,2">
                        <Path Stroke="{StaticResource Brush.Text}"
                              StrokeThickness="2"
                              Data="M 0,20 C 5,15 5,5 0,0"
                              Margin="4,0"/>
                        <Path Stroke="{StaticResource Brush.Text}"
                              StrokeThickness="2"
                              Data="M 0,20 C 5,15 5,5 0,0"
                              Margin="4,0"/>
                        <Path Stroke="{StaticResource Brush.Text}"
                              StrokeThickness="2"
                              Data="M 0,20 C 5,15 5,5 0,0"
                              Margin="4,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource Brush.Text}"
                               FontWeight="Bold"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Viewbox x:Name="ErrorOverlay"
                         Width="20" Height="20"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="4,3,0,0"
                         IsHitTestVisible="False"
                         Visibility="Collapsed">
                    <Canvas Width="50" Height="50">
                        <Ellipse x:Name="ErrorBadge"
                                 Width="50" Height="50"
                                 Stroke="Black"
                                 StrokeThickness="3"/>
                        <Rectangle Width="6" Height="20"
                                   Canvas.Left="22" Canvas.Top="10"
                                   RadiusX="1" RadiusY="1"
                                   Fill="Black"/>
                        <Ellipse Width="6" Height="6"
                                 Canvas.Left="22" Canvas.Top="34"
                                 Fill="Black"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Button>
    </Grid>
</UserControl>
