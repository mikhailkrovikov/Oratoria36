<UserControl x:Class="Oratoria.UI.Controls.Mnemo.RRGControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="130"
             d:DesignHeight="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RRGShape" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.ColumnSpan="3"
                Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButton}"
                Cursor="Hand"
                Padding="0">
            <Grid>
                <Rectangle x:Name="Body" Style="{StaticResource RRGShape}"/>
                <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=РРГ-{0}}"
                           Foreground="{StaticResource Brush.Text}"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Viewbox x:Name="ErrorOverlay"
                         Width="20" Height="20"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="2,2,0,0"
                         IsHitTestVisible="False"
                         Visibility="Collapsed">
                    <Canvas Width="50" Height="50">
                        <Ellipse x:Name="ErrorBadge"
                                 Width="50" Height="50"
                                 Stroke="Black"
                                 StrokeThickness="3"/>
                        <Rectangle Width="6" Height="20"
                                   Canvas.Left="22" Canvas.Top="10"
                                   RadiusX="1" RadiusY="1"
                                   Fill="Black"/>
                        <Ellipse Width="6" Height="6"
                                 Canvas.Left="22" Canvas.Top="34"
                                 Fill="Black"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Button>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Уставка:"
                   FontSize="12"
                   Foreground="{StaticResource Brush.Text}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Текущее:"
                   FontSize="12"
                   Foreground="{StaticResource Brush.Text}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="{Binding RRGSetPoint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Accent}"
                   FontSize="14"
                   FontWeight="Bold"
                   VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{Binding RRGRealValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Accent}"
                   FontSize="14"
                   FontWeight="Bold"
                   VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="л/ч"
                   FontSize="12"
                   Foreground="{StaticResource Brush.Text}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="2" Grid.Column="2"
                   Text="л/ч"
                   FontSize="12"
                   Foreground="{StaticResource Brush.Text}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
