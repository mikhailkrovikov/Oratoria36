<UserControl x:Class="Oratoria.UI.Controls.Mnemo.LeakerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="85"
             d:DesignHeight="120">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LeakerShape" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Text}"
                   FontWeight="Bold"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,5,0,0"
                   Grid.Row="0"/>

        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButton}"
                Cursor="Hand"
                Padding="0"
                Grid.Row="1">
            <Viewbox Stretch="Uniform">
                <Canvas Width="180" Height="165">
                    <Line X1="90" Y1="55" X2="90" Y2="115"
                          Style="{StaticResource LeakerShape}"/>

                    <Path x:Name="Body"
                          Canvas.Left="36" Canvas.Top="2.824"
                          Width="108"
                          Height="60"
                          Style="{StaticResource LeakerShape}"
                          Stretch="Fill">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,50">
                                    <LineSegment Point="0,25"/>
                                    <ArcSegment Point="25,0" Size="25,25" SweepDirection="Clockwise"/>
                                    <LineSegment Point="75,0"/>
                                    <ArcSegment Point="100,25" Size="25,25" SweepDirection="Clockwise"/>
                                    <LineSegment Point="100,50"/>
                                    <LineSegment Point="0,50"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>

                    <Path x:Name="LeftFlap"
                          Data="M 0,20 L 0,80 L 70,50 Z"
                          Style="{StaticResource LeakerShape}"
                          Canvas.Left="0" Canvas.Top="75"
                          Stretch="Fill"
                          Width="90" Height="80"/>

                    <Path x:Name="RightFlap"
                          Data="M 100,20 L 100,80 L 30,50 Z"
                          Style="{StaticResource LeakerShape}"
                          Canvas.Left="90" Canvas.Top="75"
                          Stretch="Fill"
                          Width="90" Height="80"/>

                    <Ellipse x:Name="Center"
                             Canvas.Left="70" Canvas.Top="95"
                             Width="40" Height="40"
                             Style="{StaticResource LeakerShape}"/>
                </Canvas>
            </Viewbox>
        </Button>

        <TextBlock Text="{Binding Setpoint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Accent}"
                   FontWeight="Bold"
                   FontSize="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Width="52"
                   Margin="21,78,0,0"
                   Grid.Row="1"
                   Grid.RowSpan="2"/>
        <TextBlock Text="%"
                   Foreground="{StaticResource Brush.Text}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Width="38"
                   Margin="47,0,0,0"
                   Grid.Row="2"/>
    </Grid>
</UserControl>
