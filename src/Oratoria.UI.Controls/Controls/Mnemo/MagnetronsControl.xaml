<UserControl x:Class="Oratoria.UI.Controls.Mnemo.MagnetronsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="122"
             d:DesignHeight="122">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MagnetronShape" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="200" Background="Transparent">
            <Button Canvas.Left="50" Canvas.Top="10"
                    Width="100" Height="100"
                    Command="{Binding M1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding M1CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource InvisibleButton}"
                    Cursor="Hand">
                <Grid Width="100" Height="100">
                    <Ellipse x:Name="M1Body" Style="{StaticResource MagnetronShape}"/>
                    <StackPanel VerticalAlignment="Center" Width="100">
                        <TextBlock Text="М1"
                                   Foreground="{StaticResource Brush.Text}"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="{Binding M1Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource Brush.Accent}"/>
                            <Run Text="%"
                                 FontSize="18"
                                 Foreground="{StaticResource Brush.Text}"/>
                        </TextBlock>
                    </StackPanel>
                    <Viewbox x:Name="M1ErrorOverlay"
                             Width="35" Height="35"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Canvas Width="50" Height="50">
                            <Ellipse x:Name="M1ErrorBadge"
                                     Width="50" Height="50"
                                     Stroke="Black"
                                     StrokeThickness="3"/>
                            <Rectangle Width="6" Height="20"
                                       Canvas.Left="22" Canvas.Top="10"
                                       RadiusX="1" RadiusY="1"
                                       Fill="Black"/>
                            <Ellipse Width="6" Height="6"
                                     Canvas.Left="22" Canvas.Top="34"
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Button>

            <Button Canvas.Left="0" Canvas.Top="95"
                    Width="100" Height="100"
                    Command="{Binding M2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding M2CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource InvisibleButton}"
                    Cursor="Hand">
                <Grid Width="100" Height="100">
                    <Ellipse x:Name="M2Body" Style="{StaticResource MagnetronShape}"/>
                    <StackPanel VerticalAlignment="Center" Width="100">
                        <TextBlock Text="М2"
                                   Foreground="{StaticResource Brush.Text}"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="{Binding M2Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource Brush.Accent}"/>
                            <Run Text="%"
                                 FontSize="18"
                                 Foreground="{StaticResource Brush.Text}"/>
                        </TextBlock>
                    </StackPanel>
                    <Viewbox x:Name="M2ErrorOverlay"
                             Width="35" Height="35"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Canvas Width="50" Height="50">
                            <Ellipse x:Name="M2ErrorBadge"
                                     Width="50" Height="50"
                                     Stroke="Black"
                                     StrokeThickness="3"/>
                            <Rectangle Width="6" Height="20"
                                       Canvas.Left="22" Canvas.Top="10"
                                       RadiusX="1" RadiusY="1"
                                       Fill="Black"/>
                            <Ellipse Width="6" Height="6"
                                     Canvas.Left="22" Canvas.Top="34"
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Button>

            <Button Canvas.Left="100" Canvas.Top="95"
                    Width="100" Height="100"
                    Command="{Binding M3Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding M3CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource InvisibleButton}"
                    Cursor="Hand">
                <Grid Width="100" Height="100">
                    <Ellipse x:Name="M3Body" Style="{StaticResource MagnetronShape}"/>
                    <StackPanel VerticalAlignment="Center" Width="100">
                        <TextBlock Text="М3"
                                   Foreground="{StaticResource Brush.Text}"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="{Binding M3Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource Brush.Accent}"/>
                            <Run Text="%"
                                 FontSize="18"
                                 Foreground="{StaticResource Brush.Text}"/>
                        </TextBlock>
                    </StackPanel>
                    <Viewbox x:Name="M3ErrorOverlay"
                             Width="35" Height="35"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Canvas Width="50" Height="50">
                            <Ellipse x:Name="M3ErrorBadge"
                                     Width="50" Height="50"
                                     Stroke="Black"
                                     StrokeThickness="3"/>
                            <Rectangle Width="6" Height="20"
                                       Canvas.Left="22" Canvas.Top="10"
                                       RadiusX="1" RadiusY="1"
                                       Fill="Black"/>
                            <Ellipse Width="6" Height="6"
                                     Canvas.Left="22" Canvas.Top="34"
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Button>
        </Canvas>
    </Viewbox>
</UserControl>
