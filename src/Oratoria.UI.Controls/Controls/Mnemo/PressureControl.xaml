<UserControl x:Class="Oratoria.UI.Controls.Mnemo.PressureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="186"
             d:DesignHeight="52">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="16"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Низкий вакуум"
                   Foreground="{StaticResource Brush.Text}"
                   FontWeight="Bold"
                   FontSize="12"
                   VerticalAlignment="Center"/>
        <TextBlock Text="Высокий вакуум"
                   Foreground="{StaticResource Brush.Text}"
                   FontWeight="Bold"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Grid.Row="1"
                   Visibility="{Binding ShowBottomLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <TextBlock Text="{Binding LowVacuum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Accent}"
                   FontWeight="Bold"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Grid.Column="1"/>
        <TextBlock Text="{Binding HighVacuum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Accent}"
                   FontWeight="Bold"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Grid.Row="1"
                   Grid.Column="1"
                   Visibility="{Binding ShowBottomLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <TextBlock Text="Па"
                   Foreground="{StaticResource Brush.Text}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Grid.Column="2"/>
        <TextBlock Text="Па"
                   Foreground="{StaticResource Brush.Text}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Grid.Row="1"
                   Grid.Column="2"
                   Visibility="{Binding ShowBottomLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
