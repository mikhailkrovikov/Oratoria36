<UserControl x:Class="Oratoria.UI.Controls.Mnemo.ManipulatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="135"
             d:DesignHeight="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ManipulatorArm" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ManipulatorClaw" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="4"/>
                <Setter Property="Fill" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButton}"
                Cursor="Hand">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="MainCanvas" Height="100" Width="135" Background="Transparent">
                    <Canvas x:Name="ManipulatorCanvas" Canvas.Left="67.5" Canvas.Top="50" RenderTransformOrigin="0,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="ManipulatorRotation" Angle="0"/>
                        </Canvas.RenderTransform>

                        <Rectangle x:Name="Arm"
                                   Width="50" Height="4"
                                   Style="{StaticResource ManipulatorArm}"
                                   Canvas.Left="5" Canvas.Top="-2"/>
                        <Ellipse x:Name="Joint"
                                 Width="10" Height="10"
                                 Style="{StaticResource ManipulatorArm}"
                                 Canvas.Left="0" Canvas.Top="-5"/>

                        <Path x:Name="Claw"
                              Style="{StaticResource ManipulatorClaw}"
                              Canvas.Left="51" Canvas.Top="-17.5"
                              Height="35" Stretch="Fill" Width="22"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              RenderTransformOrigin="0.292,0.54">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="0,10">
                                        <ArcSegment Point="0,0" Size="20,10" IsLargeArc="False" SweepDirection="Clockwise"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Canvas>

                    <TextBlock Text="{Binding PositionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Canvas.Bottom="20"
                               FontSize="14"
                               Width="135"
                               Foreground="{StaticResource Brush.Text}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Viewbox x:Name="ErrorOverlay"
                             Width="24" Height="24"
                             Canvas.Left="4" Canvas.Top="4"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Canvas Width="50" Height="50">
                            <Ellipse x:Name="ErrorBadge"
                                     Width="50" Height="50"
                                     Stroke="Black"
                                     StrokeThickness="3"/>
                            <Rectangle Width="6" Height="20"
                                       Canvas.Left="22" Canvas.Top="10"
                                       RadiusX="1" RadiusY="1"
                                       Fill="Black"/>
                            <Ellipse Width="6" Height="6"
                                     Canvas.Left="22" Canvas.Top="34"
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
