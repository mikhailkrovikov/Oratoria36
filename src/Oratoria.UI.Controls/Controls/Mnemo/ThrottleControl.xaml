<UserControl x:Class="Oratoria.UI.Controls.Mnemo.ThrottleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="122"
             d:DesignHeight="135">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Oratoria.UI.Controls;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InvisibleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThrottleShape" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="StrokeThickness" Value="4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Text}"
                   FontWeight="Bold"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Grid.Row="0"/>

        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButton}"
                Cursor="Hand"
                Grid.Row="1">
            <Viewbox Stretch="Uniform">
                <Canvas Width="100" Height="100" Margin="0,-20,0,20">
                    <Path x:Name="Body"
                          Style="{StaticResource ThrottleShape}"
                          Data="M1,99 L1,40 L99,40 L99,99 Z"/>

                    <Ellipse Width="10" Height="10"
                             Canvas.Left="45" Canvas.Top="65"
                             Style="{StaticResource ThrottleShape}"
                             Fill="{StaticResource Brush.Text}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"/>

                    <Path x:Name="Flap"
                          Style="{StaticResource ThrottleShape}"
                          Data="M10,50 L90,90"/>

                    <Viewbox x:Name="ErrorOverlay"
                             Width="24" Height="24"
                             Canvas.Left="6" Canvas.Top="44"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Canvas Width="50" Height="50">
                            <Ellipse x:Name="ErrorBadge"
                                     Width="50" Height="50"
                                     Stroke="Black"
                                     StrokeThickness="3"/>
                            <Rectangle Width="6" Height="20"
                                       Canvas.Left="22" Canvas.Top="10"
                                       RadiusX="1" RadiusY="1"
                                       Fill="Black"/>
                            <Ellipse Width="6" Height="6"
                                     Canvas.Left="22" Canvas.Top="34"
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>
                </Canvas>
            </Viewbox>
        </Button>

        <TextBlock Text="{Binding PositionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource Brush.Text}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Grid.Row="2"/>
    </Grid>
</UserControl>
