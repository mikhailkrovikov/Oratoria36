<UserControl x:Class="Oratoria.UI.Controls.Navigation.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="80"
             Background="{DynamicResource Brush.Window}"
             BorderThickness="1"
             BorderBrush="{DynamicResource Brush.BorderLight}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="RootPanel" Grid.Row="0" Orientation="Horizontal"/>
        <Border Grid.Row="1" Background="{DynamicResource Brush.BorderLight}"/>
        <StackPanel x:Name="ChildPanel" Grid.Row="2" Orientation="Horizontal"/>
    </Grid>
</UserControl>