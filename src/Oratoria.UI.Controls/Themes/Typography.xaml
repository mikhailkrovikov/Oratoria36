<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Label.Body" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Text.Header" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Label.Header" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Button.Border}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Header}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Text.Warning" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
    </Style>

    <Style x:Key="Label.Warning" TargetType="Label">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
    </Style>

    <Style x:Key="Text.Accent" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    </Style>

    <Style x:Key="Label.Accent" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    </Style>

    <Style x:Key="Text.Subtle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSubtle}"/>
    </Style>

    <Style x:Key="Label.Subtle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSubtle}"/>
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Label.ParamHeader" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Label.Param" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0.5,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="Label.ParamAccent" TargetType="Label" BasedOn="{StaticResource Label.Param}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    </Style>

    <Style x:Key="BaseTextTextBlock" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"/>
    <Style x:Key="BaseTextLabel" TargetType="Label" BasedOn="{StaticResource Label.Body}"/>
    <Style x:Key="HeaderTextBlock" TargetType="TextBlock" BasedOn="{StaticResource Text.Header}"/>
    <Style x:Key="HeaderLabel" TargetType="Label" BasedOn="{StaticResource Label.Header}"/>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}"/>
    <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}"/>
    <Style x:Key="ErrorLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Warning}"/>
    <Style x:Key="ErrorStyle" TargetType="Label" BasedOn="{StaticResource Label.Warning}"/>
    <Style x:Key="AnalogBlueValueTextBlock" TargetType="TextBlock" BasedOn="{StaticResource Text.Accent}"/>
    <Style x:Key="AnalogBlueValueLabel" TargetType="Label" BasedOn="{StaticResource Label.Accent}"/>
    <Style x:Key="AnalogGreyValueTextBlock" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtle}"/>
    <Style x:Key="AnalogGreyValueLabel" TargetType="Label" BasedOn="{StaticResource Label.Subtle}"/>
    <Style x:Key="StaticValueTextBlock" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"/>
    <Style x:Key="RealValueHeaderLabel" TargetType="Label" BasedOn="{StaticResource Label.ParamHeader}"/>
    <Style x:Key="RealValueLabel" TargetType="Label" BasedOn="{StaticResource Label.Param}"/>
    <Style x:Key="DynamicRealValueLabel" TargetType="Label" BasedOn="{StaticResource Label.ParamAccent}"/>

</ResourceDictionary>
