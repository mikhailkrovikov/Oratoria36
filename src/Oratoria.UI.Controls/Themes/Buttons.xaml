<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Button.Background}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Button.Border}"/>
    </Style>

    <Style x:Key="Button.Action" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Button.Nav" TargetType="Button" BasedOn="{StaticResource Button.Action}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="140"/>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Action}">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}"/>
    </Style>

    <Style x:Key="Button.Frame" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="0.5,0,0.5,0.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}"/>
    </Style>

    <Style x:Key="Button.Invisible" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaseEnableButton" TargetType="Button" BasedOn="{StaticResource Button.Base}"/>
    <Style x:Key="MainActionBlueButton" TargetType="Button" BasedOn="{StaticResource Button.Action}"/>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource Button.Nav}"/>
    <Style x:Key="StopRedButtton" TargetType="Button" BasedOn="{StaticResource Button.Danger}"/>
    <Style x:Key="FrameButton" TargetType="Button" BasedOn="{StaticResource Button.Frame}"/>
    <Style x:Key="InvisibleButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Invisible}"/>

</ResourceDictionary>
