<Page x:Class="Oratoria.UI.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Oratoria.UI.Views.Pages"
      xmlns:mnemo="clr-namespace:Oratoria.UI.Controls.Mnemo;assembly=Oratoria.UI.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="{DynamicResource Brush.Window}">

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                Padding="0,0,5,0"
                Background="{StaticResource Brush.Surface}">

            <DockPanel>
                <UniformGrid DockPanel.Dock="Left"
                             Rows="6"
                             Margin="5">
                    <TextBlock Text="Модуль 1"
                               Style="{StaticResource ModulesParametersTextBlock}"/>
                    <TextBlock Text="Модуль 2"
                               Style="{StaticResource ModulesParametersTextBlock}"/>
                    <TextBlock Text="Модуль 3"
                               Style="{StaticResource ModulesParametersTextBlock}"/>
                    <TextBlock Text="Модуль 4"
                               Style="{StaticResource ModulesParametersTextBlock}"/>
                    <TextBlock Text="Шлюз 1"
                               Style="{StaticResource ModulesParametersTextBlock}"/>
                    <TextBlock Text="Шлюз 2"
                               Style="{StaticResource ModulesParametersTextBlock}"/>
                </UniformGrid>

                <UniformGrid DockPanel.Dock="Right"
                             Rows="6"
                             Margin="5">
                    <CheckBox x:Name="Module1"
                              Style="{StaticResource ModulesParametersCheckBox}"/>
                    <CheckBox x:Name="Module2"
                              Style="{StaticResource ModulesParametersCheckBox}"/>
                    <CheckBox x:Name="Module3"
                              Style="{StaticResource ModulesParametersCheckBox}"/>
                    <CheckBox x:Name="Module4"
                              Style="{StaticResource ModulesParametersCheckBox}"/>
                    <CheckBox x:Name="Gate1"
                              Style="{StaticResource ModulesParametersCheckBox}"/>
                    <CheckBox x:Name="Gate2"
                              Style="{StaticResource ModulesParametersCheckBox}"/>
                </UniformGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="0"
                Grid.Row="1"
                Padding="0,0,5,0"
                Background="{StaticResource Brush.Surface}">

            <StackPanel DockPanel.Dock="Top">

                <Button Content="Инициализация"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,0,0,0"/>
                <Button Content="Подготовка"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
                <Button Content="Запуск рабочего цикла"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
                <Button Content="В ожидание"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
                <Button Content="Напуск шлюза 1"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
                <Button Content="Откачать шлюз 1"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
                <Button Content="Напуск шлюза 2"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
                <Button Content="Откачать шлюз 2"
                        Style="{StaticResource Button.Base}"
                        Height="32"
                        Margin="0,5,0,0"/>
            </StackPanel>
        </Border>


        <Border Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                Padding="5,0,0,5"
                Background="{StaticResource Brush.Surface}">

            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Visible">

                <TextBlock Text="Путь пластины"/>
            </ScrollViewer>

        </Border>

        <Border Grid.Column="1"
                Grid.Row="1"
                Padding="5,5,5,0"
                Background="{StaticResource Brush.Surface}">

            <TextBox Text="Параметры маршрута"/>

        </Border>

        <Border Grid.Column="2"
        Grid.Row="1"
        Background="{StaticResource Brush.Surface}">
            <Viewbox Stretch="Uniform">
                <Canvas Width="750" Height="750" Background="Transparent">
                    <mnemo:CameraControl Canvas.Left="20" Canvas.Top="22" Width="260" Height="203"/>

                    <mnemo:CameraControl Canvas.Left="20" Canvas.Top="259" Width="260" Height="203"/>

                    <mnemo:CameraControl Canvas.Left="20" Canvas.Top="495" Width="260" Height="203" RenderTransformOrigin="0.5,0.5">
                        <mnemo:CameraControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="180"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </mnemo:CameraControl.RenderTransform>
                    </mnemo:CameraControl>

                    <Rectangle Stroke="{DynamicResource Brush.BorderLight}"
                       StrokeThickness="4"
                       Canvas.Left="280"
                       Canvas.Top="72"
                       Width="191"
                       Height="577"/>
                    
                    <mnemo:CameraControl Canvas.Left="470" Canvas.Top="22" Width="260" Height="203"/>

                    <mnemo:CameraControl Canvas.Left="470" Canvas.Top="259" Width="260" Height="203"/>

                    <mnemo:CameraControl Canvas.Left="470" Canvas.Top="495" Width="260" Height="203" RenderTransformOrigin="0.5,0.5">
                        <mnemo:CameraControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="180"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </mnemo:CameraControl.RenderTransform>
                    </mnemo:CameraControl>

                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</Page>
