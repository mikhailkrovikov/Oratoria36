<Page x:Class="Oratoria.UI.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Oratoria.UI.Views.Pages"
      xmlns:mnemo="clr-namespace:Oratoria.UI.Controls.Mnemo;assembly=Oratoria.UI.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="{DynamicResource Brush.Window}">

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource SoftGroupContainer}"
                        Padding="10">
                    <UniformGrid Grid.Column="0"
                                 Columns="3"
                                 Rows="2">
                        <CheckBox x:Name="Module1"
                                  Content="Модуль 1"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModulesParametersCheckBox}"/>
                        <CheckBox x:Name="Module2"
                                  Content="Модуль 2"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModulesParametersCheckBox}"/>
                        <CheckBox x:Name="Module3"
                                  Content="Модуль 3"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModulesParametersCheckBox}"/>
                        <CheckBox x:Name="Module4"
                                  Content="Модуль 4"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModulesParametersCheckBox}"/>
                        <CheckBox x:Name="Gate1"
                                  Content="Шлюз 1"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModulesParametersCheckBox}"/>
                        <CheckBox x:Name="Gate2"
                                  Content="Шлюз 2"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModulesParametersCheckBox}"/>
                    </UniformGrid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource SoftGroupContainer}"
                        Padding="10">
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"> 
                        <Label Content="Количество пластин: "
                               Style="{StaticResource Label.Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <ComboBox/>
                    </StackPanel>
                </Border>
                
                <!--<Border Grid.Row="0"
                        Style="{StaticResource SoftGroupContainer}"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80*"/>
