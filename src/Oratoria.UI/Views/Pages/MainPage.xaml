<Page x:Class="Oratoria.UI.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Oratoria.UI.Views.Pages"
      xmlns:mnemo="clr-namespace:Oratoria.UI.Controls.Mnemo;assembly=Oratoria.UI.Controls"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MainPage"
      Background="{DynamicResource Brush.Window}">

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <!--Лево: пластины-->
        <Border Grid.Column="0"
                Margin="0,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource SoftGroupContainer}">
                    <DockPanel LastChildFill="False">

                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Vertical"
                                    Margin="0,10,0,0">
                            <CheckBox x:Name="Module1"
                                      Content="Модуль 1"
                                      Style="{StaticResource ModulesParametersCheckBox}"
                                      Margin="5"/>
                            <CheckBox x:Name="Module2"
                                      Content="Модуль 2"
                                      Style="{StaticResource ModulesParametersCheckBox}"
                                      Margin="5"/>
                            <CheckBox x:Name="Module3"
                                      Content="Модуль 3"
                                      Style="{StaticResource ModulesParametersCheckBox}"
                                      Margin="5"/>
                            <CheckBox x:Name="Module4"
                                      Content="Модуль 4"
                                      Style="{StaticResource ModulesParametersCheckBox}"
                                      Margin="5"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Vertical"
                                    Margin="0,10,0,0">
                            <CheckBox x:Name="Gate1"
                                        Content="Шлюз 1"
                                        Style="{StaticResource ModulesParametersCheckBox}"
                                        Margin="5"/>
                            <CheckBox x:Name="Gate2"
                                        Content="Шлюз 2"
                                        Style="{StaticResource ModulesParametersCheckBox}"
                                        Margin="5"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Label Content="Количество пластин: "
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                            <TextBox Width="30"
                                     Height="20"
                                     HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Vertical"
                                    Margin="0,10,0,0">
                            <RadioButton GroupName="Algorithm"
                                         Content="Последовательный"
                                         Margin="5"/>
                            <RadioButton GroupName="Algorithm"
                                         Content="Параллельный"
                                         Margin="5"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Vertical">
                            <Button Content="Инициализация"
                                    Style="{StaticResource Button.Base}"
                                    Height="32"
                                    Margin="5"/>
                            <Button Content="Подготовка"
                                    Style="{StaticResource Button.Base}"
                                    Height="32"
                                    Margin="5"/>
                            <Button Content="Запуск рабочего цикла"
                                    Style="{StaticResource Button.Base}"
                                    Height="32"
                                    Margin="5"/>
                            <Button Content="В ожидание"
                                    Style="{StaticResource Button.Base}"
                                    Height="32"
                                    Margin="5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource SoftGroupContainer}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="Пластина: "
                                        Margin="5"/>
                            <ComboBox Margin="5"/>
                        </StackPanel>

                        <DataGrid Grid.Row="0"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Шаг"/>
                                <DataGridComboBoxColumn Header="Модуль"/>
                                <DataGridComboBoxColumn Header="Рецепт"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="Добавить шаг"
                                    Height="32"
                                    MinWidth="100"
                                    Style="{StaticResource Button.Base}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--Право: мнемосхема + кнопки-->
        <Border Grid.Column="1"
                Style="{StaticResource SoftGroupContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Viewbox Grid.Row="0"
                         Stretch="Uniform">
                    <Canvas Width="750"
                            Height="750"
                            Background="Transparent">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90"/>
                                <TranslateTransform X="750" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <mnemo:CameraControl Canvas.Left="20"
                                             Canvas.Top="22"
                                             Width="260"
                                             Height="203"/>

                        <mnemo:CameraControl Canvas.Left="20"
                                             Canvas.Top="259"
                                             Width="260"
                                             Height="203"/>

                        <mnemo:CameraControl Canvas.Left="20"
                                             Canvas.Top="495"
                                             Width="260"
                                             Height="203"
                                             RenderTransformOrigin="0.5,0.5">
                            <mnemo:CameraControl.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="180"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </mnemo:CameraControl.RenderTransform>
                        </mnemo:CameraControl>

                        <Rectangle Stroke="{DynamicResource Brush.BorderLight}"
                                   StrokeThickness="4"
                                   Canvas.Left="280"
                                   Canvas.Top="72"
                                   Width="191"
                                   Height="577"/>

                        <mnemo:CameraControl Canvas.Left="470"
                                             Canvas.Top="22"
                                             Width="260"
                                             Height="203"/>

                        <mnemo:CameraControl Canvas.Left="470"
                                             Canvas.Top="259"
                                             Width="260"
                                             Height="203"/>

                        <mnemo:CameraControl Canvas.Left="470"
                                             Canvas.Top="495"
                                             Width="260"
                                             Height="203"
                                             RenderTransformOrigin="0.5,0.5">
                            <mnemo:CameraControl.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="180"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </mnemo:CameraControl.RenderTransform>
                        </mnemo:CameraControl>
                    </Canvas>
                </Viewbox>

                <UniformGrid Grid.Row="1"
                             Columns="2"
                             Rows="2">
                    <Button Content="Напуск шлюза 1"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="5"/>
                    <Button Content="Напуск шлюза 2"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="5"/>
                    <Button Content="Откачать шлюз 1"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="5"/>
                    <Button Content="Откачать шлюз 2"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="5"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Page>