                                      Content="Шлюз 2"
                                      FlowDirection="RightToLeft"
                                      Style="{StaticResource ModulesParametersCheckBox}"/>
                        </UniformGrid>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
