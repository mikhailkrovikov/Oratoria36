<Page x:Class="Oratoria.UI.Views.Pages.Module2RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Oratoria.UI.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Module2RecipePage"
      Background="{DynamicResource Brush.Window}">

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <!-- Возможно, стоит удалить второй столбец и просто сделать Margin для Border -->
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="70*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Рецепты рессурсов -->
        <Border Grid.Column="0"
                Style="{StaticResource SoftGroupContainer}">

            <!-- Сделала через Grid вместо DockPanel, чтобы нормально расположить кнопки управления -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Высота TextBlock на других страницах -->
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <!-- Выравняется по StackPanel, где расположены кнопки -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Рецепты процессов"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center" />

                <ListBox Grid.Row="1"
                         x:Name="RecipeListBox" />

                <StackPanel Grid.Row="2">
                    <!-- TODO: Хотелось бы изменить стиль в соответствии с ЧМИ(HMI) -->
                    <Button Content="Загрузить рецепт"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5" />

                    <Button Content="Удалить рецепт"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая панель: Таблица с данными рецепта -->
        <Border Grid.Column="2" Style="{StaticResource SoftGroupContainer}">
            <!-- Сделала через Grid вместо DockPanel, чтобы нормально расположить кнопки управления -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="60*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Высота TextBlock на других страницах -->
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Label Content="Название текущего рецепта: "
                           Style="{StaticResource Label.Accent}"
                           VerticalContentAlignment="Center"
                           Margin="0,5,15,5"/>
                    <TextBox Height="32"
                             Width="120"
                             Margin="0,5,5,5"
                             Style="{StaticResource TextBoxInput}"
                             VerticalContentAlignment="Center"
                             Text="Новый рецепт"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Очистить рецепт"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="5,5,0,5" />

                </StackPanel>

                <!-- Можно было бы включить в DataGrid, но сделано по шаблону других страниц через TextBlock -->
                <TextBlock Grid.Row="1"
                           Text="Параметры"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Grid.Row="1"
                           Text="Ед. измерения"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Grid.Row="1"
                           Text="Значения"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center" />

                <DataGrid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                          x:Name="RecipeDataGrid">
                    <!-- TODO: Добавить новый Style для DataGrid -->
                    <DataGridTextColumn IsReadOnly="True"
                                        Width="20*" />
                    <DataGridTextColumn IsReadOnly="True"
                                        Width="20*" />
                </DataGrid>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Button Content="Добавить стадию"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,15,5" />

                    <Button Content="Удалить стадию"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5" />

                    <ComboBox Height="32"
                              Margin="0,5,15,5" />
                </StackPanel>

                <!-- Захотелось логически отделить управление таблицей и сохранение результата -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Сохранить рецепт"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,5,5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>