<Page x:Class="Oratoria.UI.Views.Pages.Module2RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Oratoria.UI.Views.Pages"
      xmlns:recipe="clr-namespace:Oratoria.UI.Services.Recipe"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Module2RecipePage"
      Loaded="Page_Loaded"
      Background="{DynamicResource Brush.Window}">

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Рецепты рессурсов -->
        <Border Grid.Column="0"
                Style="{StaticResource SoftGroupContainer}">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Высота TextBlock на других страницах -->
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Рецепты процессов"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Recipes}"
                          SelectedItem="{Binding SelectedRecipe}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FrozenColumnCount="0"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource RecipeDataGrid}"
                          ColumnHeaderStyle="{StaticResource RecipeDataGridHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Создан" Width="140">
                            <DataGridTextColumn.Binding>
                                <Binding Path="CreatedAt" StringFormat="dd.MM.yyyy HH:mm">
                                    <Binding.Converter>
                                        <recipe:RecipeDateConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Margin="0,5,0,0">
                    <Button Content="Загрузить рецепт"
                            Command="{Binding LoadRecipeCommand}"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5"/>

                    <Button Content="Удалить рецепт"
                            Command="{Binding DeleteRecipeCommand}"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая панель: Таблица с данными рецепта -->
        <Border Grid.Column="2"
                Style="{StaticResource SoftGroupContainer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    
                    <Label Content="Название текущего рецепта:"
                           Style="{StaticResource Label.Accent}"
                           VerticalContentAlignment="Center"
                           Margin="0,5,10,5"/>
                    <TextBox Height="32"
                             Width="120"
                             Margin="0,5,0,5"
                             Style="{StaticResource TextBoxInput}"
                             VerticalContentAlignment="Center"
                             Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    
                    <Button Content="Очистить рецепт"
                            Command="{Binding ClearRecipeCommand}"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5"/>

                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Параметры"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1"
                           Text="Диапазон"
                           Style="{StaticResource HeaderTextBlock}"
                           HorizontalAlignment="Center"/>

                <DataGrid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                          x:Name="RecipeDataGrid"
                          Style="{StaticResource RecipeDataGrid}"
                          ColumnHeaderStyle="{StaticResource RecipeDataGridHeader}"
                          RowStyle="{StaticResource RecipeDataGridRow}"
                          CellStyle="{StaticResource RecipeDataGridCell}"
                          ItemsSource="{Binding Parameters}"
                          recipe:DataGridColumnsBehavior.ItemsSource="{Binding Steps}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Параметры"
                            Binding="{Binding Path=Name}"
                            CellStyle="{StaticResource RecipeDataGridStaticCell}"
                            IsReadOnly="True"
                            Width="220"/>
                        <DataGridTextColumn
                            Header="Диапазон"
                            Binding="{Binding Path=Interval}"
                            CellStyle="{StaticResource RecipeDataGridStaticCell}"
                            IsReadOnly="True"
                            Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Button Content="Добавить стадию"
                            Command="{Binding AddStepCommand}"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,10,5"/>

                    <Button Content="Удалить стадию"
                            Command="{Binding RemoveStepCommand}"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5"/>

                    <ComboBox Height="32"
                              Width="65"
                              ItemsSource="{Binding Steps}"
                              DisplayMemberPath="Number"
                              SelectedItem="{Binding SelectedStep}"
                              Margin="0,5,0,5"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,5,0,0">
                    
                    <Button Content="Сохранить рецепт"
                            Command="{Binding SaveRecipeCommand}"
                            Style="{StaticResource Button.Base}"
                            Height="32"
                            Margin="0,5,0,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
