<Page x:Class="Oratoria.UI.Views.Pages.Module2MnemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pages="clr-namespace:Oratoria.UI.Views.Pages"
      xmlns:mnemo="clr-namespace:Oratoria.UI.Controls.Mnemo;assembly=Oratoria.UI.Controls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=pages:Module2MnemoDemo, IsDesignTimeCreatable=True}"
      d:DesignHeight="850" d:DesignWidth="1920"
      Title="Module2Mnemo"
      Background="{DynamicResource Brush.Window}">

    <Grid>
        <mnemo:ValveControl Color="{Binding FK_KNState}" ErrorIcon="{Binding FK_KNError}" Label="{Binding FK_KNName}" Command="{Binding FK_KNCommand}" HorizontalAlignment="Left" Margin="444,280,0,0" VerticalAlignment="Top" Height="102" Width="100"/>

    </Grid>
</Page>
