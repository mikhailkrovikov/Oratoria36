<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="NLog.Database" Version="6.0.3" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\libs\digitaltwin\DigitalTwin.csproj" />
		<ProjectReference Include="..\Oratoria.Application\Oratoria.Application.csproj" />
		<ProjectReference Include="..\Oratoria.Domain\Oratoria.Domain.csproj" />
		<ProjectReference Include="..\Oratoria.Infrastructure\Oratoria.Infrastructure.csproj" />
		<ProjectReference Include="..\Oratoria.Persistence\Oratoria.Persistence.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<None Update="NLog.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
