<UserControl x:Class="Oratoria36.UI.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="80" Background="#FFE0E0E0" BorderThickness="1" BorderBrush="#A0A0A4">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True" Height="40" Width="1920">
            <StackPanel x:Name="StaticPanel" 
                      Orientation="Horizontal" 
                      DockPanel.Dock="Left"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#A0A0A4" HorizontalAlignment="Stretch"/>
        <StackPanel x:Name="DynamicPanel"
                  Grid.Row="2"
                  Orientation="Horizontal"/>
    </Grid>
</UserControl>
