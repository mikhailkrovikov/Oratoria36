<UserControl
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:local="clr-namespace:Oratoria36.UI.ModulePages.Module2"
                 xmlns:UserElements="clr-namespace:Oratoria36.UI.UserElements" x:Class="Oratoria36.UI.ModulePages.Module2.Module2Scheme"
                 mc:Ignorable="d" 
                 d:DesignHeight="700" d:DesignWidth="1300">
    <Grid>

        <UserElements:PipelineUE State="{Binding Pipeline1.State}"
                                 Direction="180"
                                 HorizontalAlignment="Left" Margin="406,417,0,0" VerticalAlignment="Top" Height="14" Width="132"/>

        <UserElements:PipelineUE State="{Binding Pipeline2.State}"
                                 Direction="180"

            HorizontalAlignment="Left" Margin="138,417,0,0" VerticalAlignment="Top" Width="140"/>

        <UserElements:GasLineUE GasName="Ar" 
                                HorizontalAlignment="Left" Margin="600,415,0,0" VerticalAlignment="Top" Width="107"/>


        <UserElements:ValveUE Label="{Binding FK_KN_DU_63.Name}"
                              State="{Binding FK_KN_DU_63.State}"
                              Command="{Binding FK_KN_DU_63.Command}"
                              Margin="538,344,677,0" Width="85" Height="111" VerticalAlignment="Top"/>

        <UserElements:RRGUe RRGRealValue="{Binding RRG1.RRGRealValue}"
                            RRGSetPoint="{Binding RRG1.RRGSetPointValue}"
                            Command="{Binding RRG1.Command}"
                            State="{Binding RRG1.State}"
                            HorizontalAlignment="Left" Margin="266,398,0,0" VerticalAlignment="Top" Height="100" Width="140"/>

        <UserElements:ManipulatorUE Position="{Binding ManipulatorModule2.Position}"
                                    State="{Binding ManipulatorModule2.State}"
                                    HorizontalAlignment="Left" Margin="768,178,0,0" VerticalAlignment="Top"/>

        <UserElements:ZatvorUE Label="{Binding ZatvorModule2.Name}"
                               State="{Binding ZatvorModule2.State}"
                               Command="{Binding ZatvorModule2.Command}"
                                HorizontalAlignment="Left" Margin="662,121,0,0" VerticalAlignment="Top" Height="206"/>

        <UserElements:MagnetronsUE HorizontalAlignment="Left" Margin="281,133,0,0" VerticalAlignment="Top" Height="125" Width="125" RenderTransformOrigin="0.615,0.515"/>
        <UserElements:HeaterUE HorizontalAlignment="Left" Margin="438,272,0,0" VerticalAlignment="Top" Width="100" RenderTransformOrigin="1.97,0.86"/>
        <UserElements:TableUE HorizontalAlignment="Left" Margin="435,168,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.211,0.275" Width="220" Height="90">

        </UserElements:TableUE>

    </Grid>
</UserControl>
