<UserControl
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:local="clr-namespace:Oratoria36.UI.ModulePages.Module2"
                 xmlns:UserElements="clr-namespace:Oratoria36.UI.UserElements" x:Class="Oratoria36.UI.ModulePages.Module2.Module2Scheme"
                 mc:Ignorable="d" 
                 d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>

        <UserElements:PipelineUE State="{Binding Pipeline1.State}"
                                 Direction="180"
            HorizontalAlignment="Left" Margin="406,417,0,0" VerticalAlignment="Top" Height="14" Width="132"/>

        <UserElements:PipelineUE State="{Binding Pipeline2.State}"
                                 Direction="180"

            HorizontalAlignment="Left" Margin="138,417,0,0" VerticalAlignment="Top" Width="140"/>

        <UserElements:GasLineUE GasName="Ar" 
                                HorizontalAlignment="Left" Margin="600,415,0,0" VerticalAlignment="Top" Width="107"/>


        <UserElements:ValveUE Label="{Binding FK_KN_DU_63.Name}"
                              State="{Binding FK_KN_DU_63.State}"
                              Command="{Binding FK_KN_DU_63.Command}"
                Margin="528,351,386,149" Height="100" Width="85"/>
        
        <UserElements:RRGUe RRGRealValue="{Binding RRG.RRGRealValue}"
                            RRGSetPoint="{Binding RRG.RRGSetPoint}"
                            State="{Binding RRG.State}"
            HorizontalAlignment="Left" Margin="266,398,0,0" VerticalAlignment="Top" Height="100" Width="140"/>

    </Grid>
</UserControl>
