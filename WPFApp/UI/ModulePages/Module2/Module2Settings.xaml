<Page x:Class="Oratoria36.UI.ModulePages.Module2.Module2Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Oratoria36.UI.ModulePages.Module2"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1920" Background="#FFE0E0E0"
      Title="Module2Settings">

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Grid.Row="0">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource SoftGroupContainer}">
                    <DockPanel>
                        <TextBlock Text="Параметры модуля" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" />

                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Название" Grid.Column="0" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Устройство" Grid.Column="1" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Ед. изм." Grid.Column="2" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Макс." Grid.Column="3" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Мин." Grid.Column="4" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Значение" Grid.Column="5" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="ParametersGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="1" Grid.Row="0" Margin="20,0,0,0">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource SoftGroupContainer}">
                    <DockPanel>
                        <TextBlock Text="Общие настройки" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" />

                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Название" Grid.Column="0" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Устройство" Grid.Column="1" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Ед. изм." Grid.Column="2" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Макс." Grid.Column="3" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Мин." Grid.Column="4" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                            <TextBlock Text="Значение" Grid.Column="5" Style="{StaticResource HeaderTextBlock}" Height="30" Margin="5,0,0,0"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="CommonSettingsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Column="1" Grid.Row="1" Content="Применить" 
                HorizontalAlignment="Right" Width="140" Height="40" 
                Margin="0,20,0,0" Style="{StaticResource NavigationButton}"
                />
    </Grid>
</Page>
