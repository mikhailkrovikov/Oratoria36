<Page x:Class="Oratoria36.UI.ModulePages.Module2.Module2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Oratoria36.UI.ModulePages.Module2"
      mc:Ignorable="d" 
      Title="Module2Page" d:DesignHeight="850" d:DesignWidth="1920" Background="#FFE0E0E0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="700"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="1300"/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>

        <local:Module2Scheme FK_KN_DU_63="{Binding FK_KN_DU_63}"
                     Pipeline1="{Binding Pipeline1}"
                     RRG1="{Binding RRG1}"
                     ZatvorModule2="{Binding ZatvorModule2}"
                     ManipulatorModule2="{Binding ManipulatorModule2}"
                     Grid.Column="1" Grid.Row="1" />

        <Button Content="Манипулятор" Style="{DynamicResource BaseEnableButton}" Grid.Column="1" Grid.Row="2" Height="30" Width="120" HorizontalAlignment="Left" Click="Button_Click"/>

    </Grid>
</Page>
