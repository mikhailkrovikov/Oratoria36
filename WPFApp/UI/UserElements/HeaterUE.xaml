<UserControl x:Class="Oratoria36.UI.UserElements.HeaterUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Oratoria36.UI.UserElements" xmlns:service="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="150">

    <UserControl.Resources>
        <service:StateToColorConverter x:Key="StateConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border BorderBrush="Black" BorderThickness="2" CornerRadius="5" 
                Background="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,2">
                        <Path Stroke="Black" StrokeThickness="2" Data="M 0,20 C 5,15 5,5 0,0" Margin="4,0"/>
                        <Path Stroke="Black" StrokeThickness="2" Data="M 0,20 C 5,15 5,5 0,0" Margin="4,0"/>
                        <Path Stroke="Black" StrokeThickness="2" Data="M 0,20 C 5,15 5,5 0,0" Margin="4,0"/>
                    </StackPanel>
                    <TextBlock Text="Нагреватель" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="Black" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
