<UserControl x:Class="Oratoria36.UI.UserElements.MagnetronsUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Oratoria36.UI.UserElements"
             xmlns:service="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">

    <UserControl.Resources>
        <service:StateToColorConverter x:Key="StateConverter"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="200">
            <Ellipse Width="100" Height="100" 
                 Stroke="Black" StrokeThickness="2" 
                 Fill="{Binding Magnetron1State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Canvas.Left="50" Canvas.Top="10"/>

            <Ellipse Width="100" Height="100" 
                 Stroke="Black" StrokeThickness="2" 
                 Fill="{Binding Magnetron2State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Canvas.Left="0" Canvas.Top="95"/>

            <Ellipse Width="100" Height="100" 
                 Stroke="Black" StrokeThickness="2" 
                 Fill="{Binding Magnetron3State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Canvas.Left="100" Canvas.Top="95"/>


            <StackPanel Canvas.Left="50" Canvas.Top="5"
                    Width="100" Height="100"
                    VerticalAlignment="Center">
                <Label Content="М1" 
                   FontWeight="Bold" FontSize="24"
                   HorizontalContentAlignment="Center"
                   Margin="0,20,0,0"
                   Padding="0"/>
                <TextBlock HorizontalAlignment="Center"
                       Margin="0,0,0,0">
                <Run Text="{Binding Magnetron1Value, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="18" Foreground="#475CA7" FontWeight="Bold"/>
                <Run Text="%" FontSize="18" Foreground="Black"/>
                </TextBlock>
            </StackPanel>


            <StackPanel Canvas.Left="0" Canvas.Top="95"
                    Width="100" Height="100"
                    VerticalAlignment="Center">
                <Label Content="М2" 
                   FontWeight="Bold" FontSize="24"
                   HorizontalContentAlignment="Center"
                   Margin="0,20,0,0"
                   Padding="0"/>
                <TextBlock HorizontalAlignment="Center"
                       Margin="0,0,0,0">
                <Run Text="{Binding Magnetron2Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#475CA7" FontSize="18" FontWeight="Bold"/>
                <Run Text="%" FontSize="18" Foreground="Black"/>
                </TextBlock>
            </StackPanel>


            <StackPanel Canvas.Left="100" Canvas.Top="95"
                    Width="100" Height="100"
                    VerticalAlignment="Center">
                <Label Content="М3" 
                   FontWeight="Bold" FontSize="24"
                   HorizontalContentAlignment="Center"
                   Margin="0,20,0,0"
                   Padding="0"/>
                <TextBlock HorizontalAlignment="Center"
                       Margin="0,0,0,0">
               <Run Text="{Binding Magnetron3Value, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="18" Foreground="#475CA7" FontWeight="Bold"/>
               <Run Text="%" FontSize="18" Foreground="Black"/>
                </TextBlock>
            </StackPanel>
        </Canvas>
    </Viewbox>
</UserControl>