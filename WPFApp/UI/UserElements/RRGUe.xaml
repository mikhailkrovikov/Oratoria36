<UserControl x:Class="Oratoria36.UI.UserElements.RRGUe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Oratoria36.UI.UserElements"
             xmlns:local1="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="140">
    <UserControl.Resources>
        <local1:StateToColorConverter x:Key="StateConverter"/>
        <Style TargetType="Rectangle" x:Key="RectangleRRGStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="StrokeThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource RectangleRRGStyle}" 
                   Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="РРГ-9" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Foreground="Black"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Уставка:" FontSize="12" Foreground="#3F3F3F" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Текущее:" FontSize="12" Foreground="#3F3F3F" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="л/ч" FontSize="12" Foreground="#3F3F3F" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="л/ч" FontSize="12" Foreground="#3F3F3F" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding  RRGSetPoint, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{DynamicResource AnalogBlueValueTextBlock}" VerticalAlignment="Bottom" FontSize="14" FontWeight="Bold"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RRGRealValue, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{DynamicResource AnalogBlueValueTextBlock}" VerticalAlignment="Bottom" FontSize="14" FontWeight="Bold"/>
    </Grid>
</UserControl>
