<UserControl x:Class="Oratoria36.UI.UserElements.TableUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Oratoria36.UI.UserElements"
             xmlns:service="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200">

    <UserControl.Resources>
        <service:StateToColorConverter x:Key="StateConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Вертикальная линия на заднем фоне -->
        <Line Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
              Stroke="Black" StrokeThickness="3"
              HorizontalAlignment="Center"
              X1="0" Y1="40" X2="0" Y2="160"
              Panel.ZIndex="-1" Margin="0,-20,0,19"/>

        <!-- Первый прямоугольник - Откат -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Откат"
                   FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="10,0,10,0"/>
        <Border Grid.Row="0" Grid.Column="1"
                BorderBrush="Black" BorderThickness="2" 
                Background="{Binding RollbackState, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="20"
                VerticalAlignment="Center"
                Margin="5">
        </Border>

        <!-- Второй прямоугольник - Нейтраль -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Нейтраль"
                   FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="10,0,10,0"/>
        <Border Grid.Row="1" Grid.Column="1"
                BorderBrush="Black" BorderThickness="2" 
                Background="{Binding NeutralState, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="20"
                VerticalAlignment="Center"
                Margin="5">
        </Border>

        <!-- Третий прямоугольник - Обработка -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Обработка"
                   FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="10,0,10,0"/>
        <Border Grid.Row="2" Grid.Column="1"
                BorderBrush="Black" BorderThickness="2" 
                Background="{Binding ProcessingState, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="20"
                VerticalAlignment="Center"
                Margin="5">
        </Border>
    </Grid>
</UserControl>
