<UserControl x:Class="Oratoria36.UI.UserElements.ZatvorUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Oratoria36.UI.UserElements"
             xmlns:service="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d" 
             Height="180" Width="75"
             MinHeight="180" MaxHeight="180"
             MinWidth="75" MaxWidth="75">

    <UserControl.Resources>
        <service:StateToColorConverter x:Key="StateConverter"/>
        <service:EnumToStringConverter x:Key="EnumToStringConverter"/>

        <Style x:Key="InvisibleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Rectangle" x:Key="RectangleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Line" x:Key="LineStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Ellipse" x:Key="CircleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#3F3F3F"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="StateTextStyle">
            <Setter Property="Foreground" Value="#3F3F3F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Style="{StaticResource LabelStyle}" Grid.Row="0" />

        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButtonStyle}"
                Padding="0" Grid.Row="1">
            <Canvas Width="75" Height="140">
                <Rectangle Canvas.Left="0" Canvas.Top="0" 
                          Width="75" Height="140"
                          Style="{StaticResource RectangleStyle}"
                          Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <Line X1="15" Y1="20" X2="60" Y2="120"
                      Style="{StaticResource LineStyle}"/>

                <Ellipse Canvas.Left="30" Canvas.Top="60" 
                        Width="15" Height="15"
                        Style="{StaticResource CircleStyle}"
                        Fill="Black"/>
            </Canvas>
        </Button>

        <!-- Используем Canvas для нижнего текста, чтобы он мог выходить за пределы контейнера -->
        <Canvas Grid.Row="2" HorizontalAlignment="Center" ClipToBounds="False">
            <TextBlock Text="{Binding State, Converter={StaticResource EnumToStringConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Style="{StaticResource StateTextStyle}" 
                      Canvas.Left="-100" Canvas.Top="-5" Width="200" TextAlignment="Center"/>
        </Canvas>
    </Grid>
</UserControl>
