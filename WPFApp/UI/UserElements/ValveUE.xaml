<UserControl x:Class="Oratoria36.UI.UserElements.ValveUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d"
             d:DesignHeight="175" d:DesignWidth="180">

    <UserControl.Resources>
        <local:StateToColorConverter x:Key="StateConverter"/>

        <Style x:Key="InvisibleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Path" x:Key="TriangleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="StrokeThickness" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Rectangle" x:Key="SquareStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="StrokeThickness" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <StackPanel>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Style="{StaticResource LabelStyle}"/>

            <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource InvisibleButtonStyle}"
                    Padding="0">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="180" Height="100">

                        <Path Data="M 0,20 L 0,80 L 70,50 Z"
                              Style="{StaticResource TriangleStyle}"
                              Canvas.Left="0"
                              Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Height="100" Stretch="Fill" Width="90"  Canvas.Top="55"/>

                        <Path Data="M 100,20 L 100,80 L 30,50 Z"
                              Style="{StaticResource TriangleStyle}"
                              Canvas.Left="90"
                              Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Height="100" Stretch="Fill" Width="90"  Canvas.Top="55" VerticalAlignment="Top"/>

                        <Line X1="90" Y1="0" X2="90" Y2="50"
                              Stroke="Black" StrokeThickness="8" Canvas.Left="0" Canvas.Top="55" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <Rectangle Canvas.Left="40" Canvas.Top="15" 
                                   Width="100" Height="40"
                                   Style="{DynamicResource SquareStyle}"
                                   Stroke="Black" StrokeThickness="4"
                                   Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>