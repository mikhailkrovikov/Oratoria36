<UserControl x:Class="Oratoria36.UI.UserElements.ValveUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d" d:DesignWidth="85" Height="120">

    <UserControl.Resources>
        <local:StateToColorConverter x:Key="StateConverter"/>
        <local:EnumToStringConverter x:Key="EnumToStringConverter"/>

        <Style x:Key="InvisibleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Path" x:Key="TriangleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Rectangle" x:Key="RectangleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Ellipse" x:Key="CircleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Line" x:Key="LineStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="StrokeThickness" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#3F3F3F"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="StateTextStyle">
            <Setter Property="Foreground" Value="#3F3F3F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Style="{StaticResource LabelStyle}" Grid.Row="0"/>

        <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource InvisibleButtonStyle}"
                Padding="0" Grid.Row="1">
            <Viewbox Stretch="Uniform">
                <Canvas Width="180" Height="165">
                    <Line X1="90" Y1="55" X2="90" Y2="115"
                        Stroke="Black" StrokeThickness="8"/>

                    <Rectangle Canvas.Left="40" Canvas.Top="15" 
                        Width="100" Height="50"
                        Style="{StaticResource RectangleStyle}"
                        Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <!-- Первая вертикальная линия, делящая прямоугольник на три части -->
                    <Line X1="73" Y1="15" X2="73" Y2="65"
                          Style="{StaticResource LineStyle}"/>

                    <!-- Вторая вертикальная линия, делящая прямоугольник на три части -->
                    <Line X1="107" Y1="15" X2="107" Y2="65"
                          Style="{StaticResource LineStyle}"/>

                    <Path Data="M 0,20 L 0,80 L 70,50 Z"
                        Style="{StaticResource TriangleStyle}"
                        Canvas.Left="0" Canvas.Top="75"
                        Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        HorizontalAlignment="Center" Stretch="Fill" VerticalAlignment="Top" Width="90" Height="80"/>

                    <Path Data="M 100,20 L 100,80 L 30,50 Z"
                        Style="{StaticResource TriangleStyle}"
                        Canvas.Left="90" Canvas.Top="75"
                        Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        HorizontalAlignment="Center" Stretch="Fill" VerticalAlignment="Center" Width="90" Height="80"/>

                    <Ellipse Canvas.Left="70" Canvas.Top="95"
                        Width="40" Height="40"
                        Style="{StaticResource CircleStyle}"
                        Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Используем Canvas для нижнего текста, чтобы он мог выходить за пределы контейнера -->
        <Canvas Grid.Row="2" HorizontalAlignment="Center" ClipToBounds="False">
            <TextBlock Text="{Binding State, Converter={StaticResource EnumToStringConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Style="{StaticResource StateTextStyle}" 
                      Canvas.Left="-100" Canvas.Top="-10" Width="200" TextAlignment="Center"/>
        </Canvas>
    </Grid>
</UserControl>
