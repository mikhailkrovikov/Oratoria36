<UserControl x:Class="Oratoria36.UI.UserElements.ValveUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="180">

    <UserControl.Resources>
        <local:StateToColorConverter x:Key="StateConverter"/>

        <Style TargetType="Path" x:Key="TriangleStyle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="StrokeThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Единственное добавление - прозрачная кнопка -->
        <Button x:Name="ClickArea" 
                Background="Transparent" 
                BorderThickness="0"
                Padding="0"
                Click="Valve_Click">
            <Viewbox Stretch="Uniform">
                <Canvas Width="180" Height="100">
                    <Path Data="M 0,20 L 0,80 L 70,50 Z"
                          Style="{StaticResource TriangleStyle}"
                          Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Height="100" Stretch="Fill" Width="90"/>

                    <Path Data="M 100,20 L 100,80 L 30,50 Z"
                          Style="{StaticResource TriangleStyle}"
                          Canvas.Left="90"
                          Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Height="100" Stretch="Fill" Width="90"/>
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>