<UserControl x:Class="Oratoria36.UI.UserElements.PipelineUE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oratoria36.Service"
             mc:Ignorable="d"
             Height="24" MinHeight="24" MaxHeight="24"
             d:DesignWidth="200">

    <UserControl.Resources>
        <local:StateToColorConverter x:Key="StateConverter"/>
        <local:HalfConverter x:Key="HalfConverter"/>
    </UserControl.Resources>

    <Grid>
        <Canvas>
            <Line X1="0" Y1="12" 
                  X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Y2="12"
                  Stroke="#A0A0A4" StrokeThickness="4"/>

            <Path Data="M -8,-8 L 0,0 L -8,8 Z" 
                  Fill="{Binding State, Converter={StaticResource StateConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Stroke="Black" StrokeThickness="1.5"
                  Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HalfConverter}}"
                  Canvas.Top="12"
                  RenderTransformOrigin="0,0">
                <Path.RenderTransform>
                    <RotateTransform Angle="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
</UserControl>