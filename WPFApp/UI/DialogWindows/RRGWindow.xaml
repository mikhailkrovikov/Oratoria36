<Window x:Class="Oratoria36.UI.DialogWindows.RRGWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oratoria36.UI.DialogWindows"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background=" #E0E0E0"
        BorderBrush="#A0A0A4 "
        BorderThickness="2"
        Height="400" 
        Width="500">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#C0C0C0" Padding="10">
            <TextBlock Text="Ручной режим управления РРГ" 
                   Foreground="#3F3F3F" 
                   FontSize="20"
                   FontWeight="Bold" Margin="10,0,0,0"/>
        </Border>


        <Grid Grid.Row="1" Margin="15,15,15,0" VerticalAlignment="Top" >
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Label Content="РРГ" Style="{DynamicResource HeaderLabel}" HorizontalContentAlignment="Left" FontWeight="Regular"  Height="40" FontSize="20" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Label Content="{Binding Status}" ContentStringFormat="Состояние: {0}" Style="{DynamicResource HeaderLabel}" HorizontalContentAlignment="Left" FontWeight="Regular"  Height="40" FontSize="20" />
            </StackPanel>

            <Label Grid.Column="0" Grid.Row="3" Content="Текущий расход, л/ч:" Style="{DynamicResource HeaderLabel}" HorizontalContentAlignment="Left" FontWeight="Regular"  Height="40" FontSize="20"/>
            <Label Grid.Column="0" Grid.Row="4" Content="Текущая уставка , л/ч:" Style="{DynamicResource HeaderLabel}" HorizontalContentAlignment="Left" FontWeight="Regular"  Height="40" FontSize="20"/>

            <Label Grid.Column="0" Grid.Row="5" Content="Новая уставка, л/ч:" Style="{DynamicResource HeaderLabel}" HorizontalContentAlignment="Left" FontWeight="Regular"  Height="40" FontSize="20"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding RRG.RRGRealValue}" Style="{DynamicResource AnalogBlueValueTextBlock }" HorizontalAlignment="Center" FontSize="24" />
            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding RRG.RRGSetPointValue}" Style="{DynamicResource AnalogBlueValueTextBlock }"  HorizontalAlignment="Center" FontSize="24" />
            <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding NewSetPoint, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxInput}" FontSize="24"/>


            <Grid Grid.Row="7" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Сбросить уставку" Command="{Binding Reset}" Style="{DynamicResource BaseEnableButton}" FontSize="20" Grid.Column="0" Width="222"/>
                <Button Content="Задать новую уставку" Command="{Binding SetNewPoint }" Style="{DynamicResource BaseEnableButton}" FontSize="20" Grid.Column="2" Width="222" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#FFC0C0C0" BorderThickness="0,1,0,0" Height="60" VerticalAlignment="Bottom">
            <Button Content="Выход"
                Height="40"
                Width="220"
                FontSize="20"
                Style="{DynamicResource BaseEnableButton}"
                Click="CloseButton_Click" HorizontalAlignment="Left" Margin="261,9,0,10"  />
        </Border>
    </Grid>
</Window>
