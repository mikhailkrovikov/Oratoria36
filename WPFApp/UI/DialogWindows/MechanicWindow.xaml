<Window x:Class="Oratoria36.UI.DialogWindows.MechanicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oratoria36.UI.DialogWindows" 
        d:DataContext="{d:DesignInstance Type=local:MechanicWindowVM}"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#E0E0E0"
        BorderBrush="#A0A0A4"
        BorderThickness="2"
        Height="570" 
        Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#C0C0C0" Padding="10">
            <TextBlock Text="Механика" 
                       Foreground="#3F3F3F" 
                       FontSize="20"
                       FontWeight="Bold" 
                       Margin="10,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.05*"/>
                <RowDefinition />
                <RowDefinition Height="0.05*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.05*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.05*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.05*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.05*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ManipulatorGrid" Grid.Row="1" Grid.Column="1" Background="#E8E8E8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10" BorderBrush="#AAAAAA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Манипулятор" 
                                   Grid.Column="0"
                                   Style="{StaticResource HeaderTextBlock}" 
                                   FontSize="18" 
                                   VerticalAlignment="Center"/>
                        <Button Content="СТОП" 
                                Grid.Column="1"
                                Command="{Binding StopCommand}"
                                Width="80" 
                                Height="30" 
                                Background="#FF4040" 
                                Foreground="White" 
                                FontWeight="Bold"
                                BorderBrush="#8B0000"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="5" BorderBrush="#AAAAAA">
                    <StackPanel>
                        <Label Content="{Binding Status}" ContentStringFormat="Состояние: {0}" 
                               Style="{DynamicResource AnalogBlueValueLabel}" 
                               FontWeight="Bold" FontSize="14" Height="30"/>
                        <Label Content="{Binding PositionText}" ContentStringFormat="Позиция: {0}" 
                               Style="{StaticResource AnalogBlueValueLabel}" 
                               FontWeight="Bold" FontSize="14" Height="30"/>
                        <Label Content="{Binding ErrorText}" ContentStringFormat="Ошибка: {0}" 
                               Style="{StaticResource AnalogBlueValueLabel}" 
                               FontWeight="Bold" FontSize="14" Height="30" 
                               Visibility="{Binding IsErrorVisible}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,15">
                        <Button Content="Загрузить" 
                                Command="{Binding Load}"
                                Style="{StaticResource NavigationButton}"
                                Width="150" 
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#4F81BD"
                                Foreground="White"
                                FontSize="14"/>
                        <Button Content="Выгрузить" 
                                Command="{Binding Unload}"
                                Style="{StaticResource NavigationButton}"
                                Width="150" 
                                Height="40"
                                Margin="30,0,0,0"
                                Background="#4F81BD"
                                Foreground="White"
                                FontSize="14"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardContainer}" Margin="15,0,15,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <RadioButton Content="С пластиной" 
                                                 IsChecked="{Binding IsWithPlate}" 
                                                 GroupName="PlateMode"
                                                 Margin="0,0,20,0" FontSize="14"/>
                                    <RadioButton Content="Без пластины" 
                                                 IsChecked="{Binding IsWithoutPlate}" 
                                                 GroupName="PlateMode"
                                                 Margin="20,0,0,0" FontSize="14"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Перемещение" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" 
                                        Content="Исходная ⟶ Транспорт" 
                                        Command="{Binding HomeToTransportCommand}"
                                        Style="{StaticResource BaseEnableButton}" 
                                        Margin="5" Height="30"/>
                                <Button Grid.Row="0" Grid.Column="1" 
                                        Content="Транспорт ⟶ Исходная" 
                                        Command="{Binding TransportToHomeCommand}"
                                        Style="{StaticResource BaseEnableButton}" 
                                        Margin="5" Height="30"/>
                                <Button Grid.Row="1" Grid.Column="0" 
                                        Content="Исходная ⟶ Модуль" 
                                        Command="{Binding HomeToModuleCommand}"
                                        Style="{StaticResource BaseEnableButton}" 
                                        Margin="5" Height="30"/>
                                <Button Grid.Row="1" Grid.Column="1" 
                                        Content="Модуль ⟶ Исходная" 
                                        Command="{Binding ModuleToHomeCommand}"
                                        Style="{StaticResource BaseEnableButton}" 
                                        Margin="5" Height="30"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Дополнительные устройства в других ячейках сетки -->
            <Grid Grid.Row="1" Grid.Column="3" Background="#E8E8E8">
                <!-- Здесь можно разместить второе устройство -->
                <Border Background="#E8E8E8" Padding="10">
                    <TextBlock Text="Место для второго устройства" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Style="{StaticResource BaseTextTextBlock}"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="5" Background="#E8E8E8">
                <!-- Здесь можно разместить третье устройство -->
                <Border Background="#E8E8E8" Padding="10">
                    <TextBlock Text="Место для третьего устройства" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Style="{StaticResource BaseTextTextBlock}"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#FFC0C0C0" BorderThickness="0,1,0,0" Height="60" VerticalAlignment="Bottom">
            <Button Content="Выход"
                    Width="220"
                    FontSize="20"
                    Style="{DynamicResource BaseEnableButton}"
                    HorizontalAlignment="Left" 
                    Margin="10,10,0,10" Click="Button_Click"/>
        </Border>
    </Grid>
</Window>
